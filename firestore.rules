rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidFullName(value) {
      return value is string
        && value.size() >= 3
        && value.size() <= 50
        && value.matches('.*\\S.*');
    }

    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list: if false;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'fullName', 'email', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'email', 'createdAt'
        ])
        && isValidFullName(request.resource.data.fullName)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'fullName', 'email', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'fullName', 'email', 'createdAt'
        ])
        && isValidFullName(request.resource.data.fullName)
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['fullName']);

      allow delete: if false;
    }

    // Citizen reports. A citizen creates a report as Pending / Processing and
    // can read only their own reports. Status and analysis results are
    // written later by the administrator and the analysis pipeline.
    // (Reading for the shared map is added in the map/security task.)
    match /reports/{reportId} {
      function isValidNewReport() {
        let data = request.resource.data;
        return data.keys().hasAll([
            'userId', 'imageUrl', 'description', 'location', 'locationSource',
            'locationAccuracyMeters', 'reportStatus', 'analysisStatus', 'issueClass', 'severity',
            'createdAt', 'updatedAt'
          ])
          && data.keys().hasOnly([
            'userId', 'imageUrl', 'description', 'location', 'locationSource',
            'locationAccuracyMeters', 'reportStatus', 'analysisStatus', 'issueClass', 'severity',
            'createdAt', 'updatedAt'
          ])
          && data.userId == request.auth.uid
          && data.imageUrl is string
          && data.imageUrl.size() > 0
          && data.description is string
          && data.description.size() <= 500
          && data.location is latlng
          // 'temporary' is allowed only until the GPS step is connected.
          && data.locationSource in ['gps', 'manual', 'temporary']
          && (data.locationAccuracyMeters == null
              || (data.locationAccuracyMeters is number
                  && data.locationAccuracyMeters >= 0))
          && data.reportStatus == 'pending'
          && data.analysisStatus == 'processing'
          && data.issueClass == null
          && data.severity == null
          && data.createdAt == request.time
          && data.updatedAt == request.time;
      }

      allow create: if request.auth != null && isValidNewReport();
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
